#!/bin/bash
# שער מדורג לפי רדיוס הפגיעה של ה-commit (הדפוס של בנייה חכמה):
#   רק ידע/תיעוד  → lint בלבד (שניות)
#   קוד/בדיקות/e2e → npm run verify המלא (typecheck+lint+test+build)
# סוויטות הדפדפן (e2e) אינן כאן — הן רצות בסוף כל אשכול לפי פקודת הבנייה.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

STAGED=$(git diff --cached --name-only)
[ -z "$STAGED" ] && exit 0

CODE_TOUCHED=$(echo "$STAGED" | grep -vE '^(knowledge/|.*\.md$)' | head -1 || true)

if [ -z "$CODE_TOUCHED" ]; then
  echo "ℹ️  commit ידע/תיעוד בלבד — שער מקוצר (lint)"
  npx oxlint
  W=$(npx oxlint 2>&1 | grep -c warning || true)
  [ "${W:-0}" -eq 0 ] || { echo "❌ אזהרות lint"; exit 1; }
  exit 0
fi

echo "🔒 שער מלא (קוד ב-staging): npm run verify"
npm run verify
