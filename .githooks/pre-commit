#!/bin/bash
# שער commit — מיובא מהענף החי של בנייה חכמה (claude/whats-happening-LyY9G):
#   • שערי שלמות fail-fast (דפוס שערים 81-83): ה-hook עצמו לא עקיף ולא מזויף
#   • שער מדורג לפי רדיוס הפגיעה: ידע/תיעוד → lint; קוד → typecheck+lint+test
#   • לקח #72: ה-build אינו כאן — הוא רץ פעם אחת ב-pre-push (לא הורג איטרציה)
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# ═══ שלמות (fail-fast, לפני כל דבר יקר) ═══
HP=$(git config core.hooksPath || echo "")
[[ "$HP" == ".githooks" ]] || { echo "❌ core.hooksPath שונה: '$HP' — הרץ: git config core.hooksPath .githooks"; exit 1; }
[[ -x .githooks/pre-commit && -x .githooks/pre-push && -x .githooks/commit-msg ]] || {
  echo "❌ hooks לא executable — הרץ: chmod +x .githooks/*"; exit 1; }

# ═══ ענף — עבודה רק על claude/* (main = deploy אוטומטי לפרודקשן) ═══
BRANCH=$(git branch --show-current 2>/dev/null || echo "")
if [[ "$BRANCH" == "main" || "$BRANCH" == "master" ]]; then
  echo "❌ commit ישירות על $BRANCH אסור — עבור לענף claude/*"; exit 1
fi

STAGED=$(git diff --cached --name-only)
[ -z "$STAGED" ] && exit 0

# ═══ שער מדורג ═══
CODE_TOUCHED=$(echo "$STAGED" | grep -vE '^(knowledge/|.*\.md$)' | head -1 || true)
if [ -z "$CODE_TOUCHED" ]; then
  echo "ℹ️  commit ידע/תיעוד בלבד — שער מקוצר (lint על קבצי-ה-staging בלבד)"
  # נחיל ב׳ 3.9: הגרסה הקודמת ספרה אזהרות בכל הריפו (125 קיימות) ⇒ כל commit-תיעוד נכשל.
  # סופרים רק את מה שב-staging; commit ללא קבצי-קוד ב-staging = אין מה ללנטט.
  LINT_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|mjs|cjs)$' || true)
  if [ -n "$LINT_FILES" ]; then
    W=$(echo "$LINT_FILES" | xargs npx oxlint 2>&1 | grep -c warning || true)
    [ "${W:-0}" -eq 0 ] || { echo "$LINT_FILES" | xargs npx oxlint; echo "❌ אזהרות lint בקבצי-ה-staging"; exit 1; }
  fi
  exit 0
fi

echo "🔒 שער commit (קוד ב-staging): typecheck + lint + test"
npm run verify:fast
