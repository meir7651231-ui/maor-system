{
  "name": "maor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/bundle-budget.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "e2e": "node e2e/toggle-matrix.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "verify:fast": "npm run typecheck && npm run lint && npm run test",
    "e2e:verticals": "node e2e/vertical-matrix.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-maor 'node e2e/rules-redteam.mjs'"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "firebase": "^12.18.0",
    "idb": "^8.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.0",
    "firebase-tools": "^15.28.2",
    "oxlint": "^1.80.0",
    "playwright-core": "^1.62.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}