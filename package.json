{
  "name": "maor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "e2e": "node e2e/toggle-matrix.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "verify:fast": "npm run typecheck && npm run lint && npm run test",
    "e2e:verticals": "node e2e/vertical-matrix.mjs"
  },
  "dependencies": {
    "fflate": "^0.6.11",
    "idb": "^8.0.3",
    "firebase": "^12.16.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.160.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "playwright-core": "^1.61.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}