{
  "name": "maor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/bundle-budget.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "e2e": "node e2e/toggle-matrix.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "verify:fast": "npm run typecheck && npm run lint && npm run test",
    "e2e:verticals": "node e2e/vertical-matrix.mjs",
    "e2e:ci": "node e2e/run-ci.mjs --suite=push",
    "e2e:nightly": "node e2e/run-ci.mjs --suite=nightly",
    "test:rules": "firebase emulators:exec --only firestore --project demo-maor 'node e2e/rules-redteam.mjs'",
    "test:backup-emu": "firebase emulators:exec --only firestore,storage --project demo-maor --config e2e/firebase.backup-emu.json 'node functions/backup-root.emu.mjs'",
    "test:backup-scale": "firebase emulators:exec --only firestore,storage --project demo-maor --config e2e/firebase.backup-emu.json 'node --expose-gc functions/backup-root.scale.emu.mjs'"
  },
  "dependencies": {
    "fflate": "^0.6.11",
    "firebase": "^12.16.0",
    "idb": "^8.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.160.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-react": "^6.0.3",
    "firebase-tools": "^15.27.0",
    "oxlint": "^1.71.0",
    "playwright-core": "^1.61.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
