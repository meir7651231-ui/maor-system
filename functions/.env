# משתני-סביבה (לא-סודות!) לפונקציות — נטענים אוטומטית בפריסה (dotenv של firebase-tools).
# סודות אמיתיים לעולם לא כאן — הם ב-Secret Manager (secrets:) או בכספת-הענן (orgSecrets).

# מיילי-העל לאימות כפתורי-האפליקציה (solaPull/nedarimPull — Bearer של מייל-על על org=root).
# המייל ממילא ציבורי בריפו (firestore.rules allowlist). בלעדיו: 403 על משיכה מהשורש.
SUPER_ADMIN_EMAILS=meir7651231@gmail.com

# הארגון לרשת-הביטחון השעתית של סולה (solaSyncHourly) — slug, לא-סוד.
# הופעל 23.8 ("שזה מסתנכרן אוטומטית"): המשיכות של הלקוח-החי יושבות ב-mavr-hchsd.
SOLA_ORG=mavr-hchsd

# הארגון בעל ה-mosad הגלובלי של נדרים (NEDARIM_MOSAD_ID/API_PASSWORD ב-Secret Manager).
# 🔒 בידוד (24.8): **רק** הארגון הזה רשאי להשתמש ב-mosad הגלובלי; org=root וכל ארגון-אחר
# חייבים כספת-משלהם — אחרת השורש מושך את נתוני-מאור לתוכו (דליפה). מקביל ל-SOLA_ORG.
# ⚠️ הגדרה זו גם מפעילה את nedarimSyncHourly (משיכה שעתית ל-mavr-hchsd). לא רוצים
# משיכה-שעתית? הסירו את השורה והזינו את ה-MosadId בכספת orgSecrets/mavr-hchsd במקום.
NEDARIM_ORG=mavr-hchsd

# 🔒 בידוד (24.8): SOLA_ROOT_VAULT הוסר — הוא גרם למשיכת org=root להשתמש בכספת של
# מאור (mavr-hchsd) ⇒ תשלומי-מאור נכתבו לשורש (Orbit). ללא-עוגן, משיכה מ-root אינה
# מוצאת xKey (הכספת יושבת ב-mavr-hchsd) ⇒ אינה מושכת דבר. המשיכות האמיתיות של מאור
# רצות דרך org=mavr-hchsd (SOLA_ORG) ואינן מושפעות.
# SOLA_ROOT_VAULT=  (מושבת במכוון)
