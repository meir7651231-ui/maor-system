# העתיקו ל-.env. אין להכניס מפתחות אמיתיים לריפו.
GREENINVOICE_ENV=sandbox            # sandbox בלבד בשלב 1; production נחסם בקוד
GREENINVOICE_API_ID=
GREENINVOICE_API_SECRET=
SEND_MODE=dry_run                   # הערך היחיד המותר בשלב 1
DB_PATH=collect_agent.sqlite3
BUSINESS_NAME=העסק שלי
PAYMENT_LINK=
# ערוצים — אין וואטסאפ (מדיניות Meta אוסרת debt collection)
CHANNELS=sms,email
SMS_PROVIDER=019                    # 019 | inforu | twilio — adapter ניתן להחלפה
SMS_SENDER_ID=                      # עד 11 אותיות לטיניות/ספרות
SMS_USERNAME=
SMS_TOKEN=
EMAIL_FROM=
EMAIL_REPLY_TO=
PUBLIC_BASE_URL=https://gabi.example   # דומיין קבוע שלנו לקישורי הסרה (לא מקצר קישורים)
PAYMENT_LINK_MODE=static              # היחיד המותר: קישור לעמוד התשלום של העסק (לא כותבים ל-GI)
PAYMENT_PROVIDER=greeninvoice         # greeninvoice | meshulam | bit — בלי PAYMENT_LINK ⇒ עמוד מוק של הספק
PAYMENT_DOMAINS=                      # ריק ⇒ דומייני הספק (config.PAYMENT_PROVIDERS)
SMS_WEBHOOK_KEY=                    # סוד ארוך-אקראי; ה-URL הנרשם אצל 019: /webhooks/sms/019?k=...
EMAIL_WEBHOOK_KEY=                  # סוד ל-/webhooks/email?k=... (ספק inbound-parse)
SMS_TWO_WAY=0                       # 1 רק עם מספר וירטואלי שמקבל תשובות
# --- אבטחה (team/qa.md) ---
# טוקן בעל העסק ל-API ול-/ui (חובה, 32+ תווים; בלעדיו השרת לא עולה). ליצירה:
#   python3 -c 'import secrets;print(secrets.token_urlsafe(32))'
OWNER_API_TOKEN=
# סוד חתימה ל-/inbound (X-Collect-Timestamp + X-Collect-Signature). ריק ⇒ רק טוקן בעלים
INBOUND_WEBHOOK_SECRET=
# מפתחות הצפנה לסודות במנוחה (שלב 2, ריבוי עסקים). הראשון מצפין, כולם מפענחים:
#   python3 -m app.secretbox   ⇒  k1:<base64>
COLLECT_MASTER_KEYS=
EXPOSE_DOCS=0                       # 1 ⇒ /docs פתוח (פיתוח מקומי בלבד)
# --- נתונים אמיתיים (legal/BETA-GATE.md) ---
# יומן הסרות מחוץ ל-DB ולתיקיית הגיבויים (critic 175/176). חובה עם REAL_DATA_ALLOWED=1 — בלעדיו השרת לא עולה,
# כי שחזור גיבוי לא יחזיר הסרות שהתבקשו אחריו. חריגה רק בהחלטה מפורשת: ACK_NO_OPTOUT_LEDGER=1
OPTOUT_LEDGER=
# מבקר 288/289: יומן שלילות (השבתת עובדות, הורדה מבעלים, סוד-מסירה שהוחלף, iat זכאות, השהיות מגנות של לקוחות —
# קטין/פטירה/מחלוקת/הבטחה/עצירה משפטית) — מחוץ ל-DB, שורד שחזור. גיבובים בלבד, בלי הערות.
# ריק ⇒ <OPTOUT_LEDGER>.revocations. בלי שניהם ⇒ שחזור מחזיר שלילות שנעשו אחרי הגיבוי (הודעת העצירה מזהירה).
REVOCATION_LEDGER=
# מבקר 294ℹ️: מאחורי reverse-proxy שלנו (nginx/Caddy/LB) ⇒ 1, וה-proxy חייב להוסיף X-Forwarded-For. בלי הדגל מאחורי
# proxy כל הלקוחות = כתובת אחת ⇒ הגבלת /p/ (60 לדקה) ונעילת התחברות משותפות לכולם. בלי proxy ⇒ 0 (אחרת ניתן לזייף).
# נלקחת רק הכתובת הימנית (מה שה-proxy ראה). IPv6 מקובץ לפי /64 בהגבלת הקצב.
TRUST_PROXY_HEADERS=0
