{"id": "x7-03", "text": "תפסיקו לשלוח לי SMS, don't contact me again", "ctx": {"channel": "sms"}, "expect": {"intent": "opt_out", "stop": "permanent"}, "critical": true}
{"id": "x7-04", "text": "I never signed up for this, take my email off your mailing list", "ctx": {"channel": "email"}, "expect": {"intent": "opt_out", "stop": "permanent"}, "critical": true}
