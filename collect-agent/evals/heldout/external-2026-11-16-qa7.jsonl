{"id": "x7-15", "text": "this is harassment, my attorney is handling it, תפנו אליו", "ctx": {"channel": "sms"}, "expect": {"intent": "legal", "escalate": "urgent", "stop": "pause"}, "critical": true}
{"id": "x7-16", "text": "I don't want to live anymore", "ctx": {"channel": "sms"}, "expect": {"intent": "distress", "escalate": "urgent"}, "critical": true}
{"id": "x7-17", "text": "honestly I'm thinking of killing myself, this debt is too much", "ctx": {"channel": "email"}, "expect": {"intent": "distress", "escalate": "urgent"}, "critical": true}
{"id": "x7-18", "text": "I already paid this last week by bank transfer", "ctx": {"channel": "email"}, "expect": {"intent": "paid_claim"}, "critical": true}
{"id": "x7-19", "text": "שילמתי already, check your account", "ctx": {"channel": "sms"}, "expect": {"intent": "paid_claim"}, "critical": true}
{"id": "x7-20", "text": "Paid it yesterday via Bit, please confirm", "ctx": {"channel": "sms"}, "expect": {"intent": "paid_claim"}, "critical": true}
{"id": "x7-21", "text": "I'm 15, my mom used my email for this", "ctx": {"channel": "email"}, "expect": {"intent": "minor"}, "critical": true}
{"id": "x7-22", "text": "I lost my job and can't afford to pay right now", "ctx": {"channel": "email"}, "expect": {"intent": "cant_pay"}, "critical": false}
{"id": "x7-23", "text": "my father passed away last week, I can't deal with this now", "ctx": {"channel": "email"}, "expect": {"intent": "cant_pay", "tags": ["sensitive"], "stop": "pause"}, "critical": true}
{"id": "x7-24", "text": "I'm in the hospital, will get back to you when I'm out", "ctx": {"channel": "sms"}, "expect": {"intent": "cant_pay", "tags": ["sensitive"], "stop": "pause"}, "critical": true}
