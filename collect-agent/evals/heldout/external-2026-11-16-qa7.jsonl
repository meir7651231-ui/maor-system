{"id": "x7-27", "text": "I'll pay on Sunday", "ctx": {"channel": "sms"}, "expect": {"intent": "promise"}, "critical": false}
{"id": "x7-28", "text": "will transfer the money by end of the month", "ctx": {"channel": "email"}, "expect": {"intent": "promise"}, "critical": false}
{"id": "x7-29", "text": "אעביר את ה-payment מחר בבוקר", "ctx": {"channel": "sms"}, "expect": {"intent": "promise"}, "critical": false}
{"id": "x7-30", "text": "Could you resend the invoice? I can't find it", "ctx": {"channel": "email"}, "expect": {"intent": "copy_request"}, "critical": false}
{"id": "x7-31", "text": "How can I pay? Do you take credit card?", "ctx": {"channel": "email"}, "expect": {"intent": "how_to_pay"}, "critical": false}
{"id": "x7-32", "text": "Who is this? I don't recognize this business", "ctx": {"channel": "sms"}, "expect": {"intent": "who_is_this"}, "critical": false}
{"id": "x7-33", "text": "please call me, I'd rather talk on the phone", "ctx": {"channel": "email"}, "expect": {"intent": "callback"}, "critical": false}
{"id": "x7-34", "text": "Thanks for the reminder!", "ctx": {"channel": "email"}, "expect": {"intent": "thanks", "stop": "none"}, "critical": false}
{"id": "x7-35", "text": "go to hell you scammers", "ctx": {"channel": "sms"}, "expect": {"intent": "abusive"}, "critical": false}
{"id": "x7-36", "text": "Is this link legit? I'm afraid it's phishing", "ctx": {"channel": "sms"}, "expect": {"intent": "who_is_this", "tags": ["phishing_concern"]}, "critical": false}
{"id": "x7-37", "text": "Stop worrying, I'll pay tomorrow :)", "ctx": {"channel": "sms"}, "expect": {"intent": "promise", "not": ["opt_out", "distress"]}, "critical": true}
{"id": "x7-38", "text": "I'm dying to finish this, paying today", "ctx": {"channel": "email"}, "expect": {"intent": "promise", "not": ["distress"]}, "critical": true}
{"id": "x7-39", "text": "my lawyer said the invoice is fine, paying now", "ctx": {"channel": "email"}, "expect": {"intent": "promise", "not": ["legal", "dispute"]}, "critical": true}
{"id": "x7-40", "text": "My son is 15 so it's been a crazy week, will pay Friday", "ctx": {"channel": "sms"}, "expect": {"intent": "promise", "not": ["minor"]}, "critical": true}
{"id": "x7-41", "text": "no problem, I'll pay. Don't need another reminder", "ctx": {"channel": "sms"}, "expect": {"intent": "promise", "not": ["opt_out"]}, "critical": true}
{"id": "x7-42", "text": "I haven't paid yet, how do I pay?", "ctx": {"channel": "email"}, "expect": {"intent": "how_to_pay", "not": ["paid_claim"]}, "critical": true}
{"id": "x7-43", "text": "This isn't wrong, just pay link please", "ctx": {"channel": "sms"}, "expect": {"intent": "how_to_pay", "not": ["dispute", "wrong_person"]}, "critical": true}
