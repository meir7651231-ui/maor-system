{"id": "xc36", "text": "לא הצלחתי לפתוח את הקישור, יש דרך אחרת לשלם?", "ctx": {"channel": "email"}, "expect": {"intent": "how_to_pay"}, "critical": false}
{"id": "xc37", "text": "אפשר שמישהו יתקשר אליי בערב? קשה לי לכתוב", "ctx": {"channel": "sms"}, "expect": {"intent": "callback"}, "critical": false}
