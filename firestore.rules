rules_version = '2';
// כללי האבטחה של פרויקט הענן maor-system — מקור האמת בריפו.
// v2 (CLOUD2 ענן 3): פלטפורמה רב-ארגונית — הרשמה/אישור/חברות, לצד אוספי
// השורש של הלקוח הקיים (allowlist כהיום).
// v3 (ORGADMIN 3.8.2026): מנהל-ארגון מואצל — orgManager(slug) יכול לעדכן רק את
// שדות ניהול-העובדות של הארגון שלו (members/memberConfigs/joinOpen/joinCode)
// ולנהל את joinRequests שלו; מייל-העל מעל כולם. config/manager = מייל-על בלבד.
// v4 (נחיל-עמוק 14.8, פאזה-0): הקשחת platformLeads — מחרוזות תחומות-גודל מול
// spam/עלות (create ציבורי). אכיפת-ייעוד/ייצוא פר-חבר בשכבת-הנתונים = פרויקט
// נפרד (local-first לא ניתן-לסינון ב-Rules) — build-order ב-knowledge/.
// הפריסה ידנית: קונסולת Firebase ← Firestore ← Rules ← הדבקה ← Publish,
// ואז הדלקת הרשמה: Authentication ← Sign-in method ← Email/Password (enable).
//
// מבנה הנתונים:
// - platformRequests/{uid} — בקשת הרשמה ממתינה (orgName, email, at).
// - platformOrgs/{slug} — מסמך ארגון: config, members[] (מיילים באותיות
//   קטנות), provisioned, orgName, createdAt.
// - orgs/{slug}/{col}/{doc} — נתוני ארגון-פלטפורמה (18 אוספים + meta/org).
// - אוספי השורש — הלקוח הקיים (cloudRoot:true), ללא שינוי.
service cloud.firestore {
  match /databases/{database}/documents {
    // מיילי-העל של הפלטפורמה — function אחת, מקור אמת יחיד.
    function superAdmin() {
      return request.auth != null
        && request.auth.token.email.lower() in [
          'meir7651231@gmail.com'
        ];
    }
    // רשימת המורשים לאוספי השורש (הלקוח הקיים) — כהיום.
    function allowedRoot() {
      return request.auth != null
        && request.auth.token.email.lower() in [
          'meir7651231@gmail.com'
          // + מייל המשרד של מאור החסד — יתווסף עם יצירתו
        ];
    }
    // חברות בארגון-פלטפורמה — המייל ברשימת ה-members של מסמך הארגון.
    function orgMember(slug) {
      return request.auth != null
        && request.auth.token.email.lower()
          in get(/databases/$(database)/documents/platformOrgs/$(slug)).data.get('members', []);
    }
    // מנהל-ארגון מואצל (ORGADMIN v3) — המייל שווה לשדה manager של הארגון.
    // המנהל מנהל את העובדות של הארגון שלו בלבד; מייל-העל מעל כולם.
    function orgManager(slug) {
      return request.auth != null
        && request.auth.token.email.lower()
          == get(/databases/$(database)/documents/platformOrgs/$(slug)).data.get('manager', '');
    }

    // בקשות הרשמה: המשתמש יוצר רק את שלו (uid תואם); קריאה/מחיקה — מיילי-על.
    match /platformRequests/{uid} {
      // נחיל-אבטחה 17.8 (ממצא #3): הקשחת-DoS — allowlist 8 השדות ש-cloudSignUp
      // כותב (5 בסיס + industry/size/needs מהאשף) + תקרות-גודל. ⚠️ קריטי: הרשימה
      // חייבת לכלול את **כל** שדות reqDoc — hasOnly חלקי (5 בלבד) שבר הרשמות-אשף
      // בעבר (CLOSED-ONBOARD 5.8). needs = list (≤20). create ע"י הנרשם (uid תואם).
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['orgName', 'contactName', 'phone', 'email', 'at', 'industry', 'size', 'needs'])
        && (!('orgName' in request.resource.data) || (request.resource.data.orgName is string && request.resource.data.orgName.size() <= 120))
        && (!('contactName' in request.resource.data) || (request.resource.data.contactName is string && request.resource.data.contactName.size() <= 100))
        && (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 30))
        && (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 120))
        && (!('at' in request.resource.data) || (request.resource.data.at is string && request.resource.data.at.size() <= 40))
        && (!('industry' in request.resource.data) || (request.resource.data.industry is string && request.resource.data.industry.size() <= 40))
        && (!('size' in request.resource.data) || (request.resource.data.size is string && request.resource.data.size.size() <= 20))
        && (!('needs' in request.resource.data) || (request.resource.data.needs is list && request.resource.data.needs.size() <= 20));
      allow read, delete: if superAdmin();
    }

    // לידים "נחזור אליכם" (SIGNUP) — לכידת-ליד ציבורית **בלי חשבון**:
    // create בלבד (בלי אימות), שדות מוגבלים; קריאה/מחיקה — מיילי-על. אין
    // read ⇒ אי-אפשר למנות/לדלות לידים; בטוח מספיק לטופס-יצירת-קשר.
    match /platformLeads/{leadId} {
      // create ציבורי (בלי חשבון) — מוקשח מפני spam/עלות (נחיל-עמוק 14.8, פאזה-0):
      // רק 5 שדות, מחרוזות תחומות-גודל ⇒ payload חסום (מסמך-ענק לא ייכתב). שם+טלפון
      // חובה ולא-ריקים; היתר אופציונליים. rate-limit אמיתי = App Check/function (בעלים).
      allow create: if request.resource.data.keys().hasOnly(['contactName', 'phone', 'preferredTime', 'notes', 'at'])
        && request.resource.data.contactName is string
        && request.resource.data.contactName.size() > 0 && request.resource.data.contactName.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0 && request.resource.data.phone.size() <= 30
        && (!('preferredTime' in request.resource.data) || (request.resource.data.preferredTime is string && request.resource.data.preferredTime.size() <= 60))
        && (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 500))
        && (!('at' in request.resource.data) || (request.resource.data.at is string && request.resource.data.at.size() <= 40));
      allow read, update, delete: if superAdmin();
    }

    // 💬 צ׳אט-תמיכה חי (17.8) — שיחה דו-כיוונית לקוח↔תמיכת-אורביט. מסמך פר-uid:
    // רק הלקוח (auth.uid==uid) ומייל-העל רואים/כותבים. הודעות = create בלבד
    // (בלתי-משתנות); `from` נאכף: הלקוח='user', מייל-על='admin'. טקסט תחום-גודל
    // (DoS). מטא-השיחה מוגבל ל-7 שדות מוכרים + תקרות (increment של unread מותר).
    match /supportChats/{uid} {
      allow read: if superAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if (superAdmin() || (request.auth != null && request.auth.uid == uid))
        && request.resource.data.keys().hasOnly(['email', 'orgName', 'lastText', 'lastAt', 'lastFrom', 'unreadAdmin', 'unreadUser'])
        && (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 120))
        && (!('orgName' in request.resource.data) || (request.resource.data.orgName is string && request.resource.data.orgName.size() <= 120))
        && (!('lastText' in request.resource.data) || (request.resource.data.lastText is string && request.resource.data.lastText.size() <= 200))
        && (!('lastAt' in request.resource.data) || (request.resource.data.lastAt is string && request.resource.data.lastAt.size() <= 40))
        && (!('lastFrom' in request.resource.data) || (request.resource.data.lastFrom is string && request.resource.data.lastFrom.size() <= 10))
        && (!('unreadAdmin' in request.resource.data) || request.resource.data.unreadAdmin is int)
        && (!('unreadUser' in request.resource.data) || request.resource.data.unreadUser is int);

      match /messages/{msgId} {
        allow read: if superAdmin() || (request.auth != null && request.auth.uid == uid);
        // create בלבד — הודעה בלתי-משתנה. from נאכף לפי הכותב (מונע התחזות).
        allow create: if request.resource.data.keys().hasOnly(['from', 'text', 'at'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
          && request.resource.data.at is string && request.resource.data.at.size() <= 40
          && (
            (request.auth != null && request.auth.uid == uid && request.resource.data.from == 'user')
            || (superAdmin() && request.resource.data.from == 'admin')
          );
      }
    }

    // מסמכי הארגונים: קריאה — חבר או מייל-על.
    // כתיבה מלאה (config/manager/provisioned) — מייל-על בלבד.
    // עדכון חלקי — מנהל-הארגון, אך **רק** לשדות ניהול-העובדות שלו
    // (members/memberConfigs/joinOpen/joinCode); לא נוגע ב-config/manager/provisioned.
    match /platformOrgs/{slug} {
      // קריאת-מסמך-יחיד (get) — חבר או מייל-על; וכן **מצבת-מחיקה** (deleted:true,
      // 5.8) — כל מחובר רשאי לקרוא אותה (היא מכילה רק את עובדת-המחיקה), כדי
      // שהלקוח ידע שהארגון הוסר וינקה את המגירה המקומית שלו.
      // 21.8 ("המנהל נשאר תקוע בחוץ"): גם מנהל-הארגון (שדה manager) רשאי get —
      // מנהל שנשמט מ-members (דריסת-מערך ישנה) לא יכול היה אפילו לקרוא את מסמך-
      // הארגון כדי שהקליינט יזהה אותו כמנהל. resource.data ישיר — בלי get() נוסף.
      allow get: if superAdmin() || orgMember(slug)
        || (request.auth != null
            && request.auth.token.email.lower() == resource.data.get('manager', ''))
        || (request.auth != null && resource.data.get('deleted', false) == true);
      // שאילתה (list) — מייל-על (לוח-הבקרה: כל הארגונים) או **ניתוב-עצמי**:
      // המשתמש רשאי לשאול רק מסמכים שבהם המייל שלו ב-members (array-contains).
      // כך "כפתור הכניסה" מוצא את הארגון של המנהל/העובד בלי לחשוף את שאר הרשימה
      // (Firestore דוחה שאילתה לא-מסוננת ⇒ אי-אפשר למנות ארגונים זרים).
      allow list: if superAdmin()
        || (request.auth != null
            && request.auth.token.email.lower() in resource.data.get('members', []));
      allow create, delete: if superAdmin();
      allow update: if superAdmin()
        || (orgManager(slug)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['members', 'memberConfigs', 'joinOpen', 'joinCode']));

      // בקשות-הצטרפות של עובדות — יצירה ע"י המבקש (uid תואם); קריאה/מחיקה —
      // מנהל-הארגון או מייל-על. אישור/דחייה = המנהל מעדכן members/memberConfigs למעלה
      // ואז מוחק את הבקשה.
      match /joinRequests/{uid} {
        // נחיל-אבטחה 17.8 (ממצא #2 · MEDIUM): הקשחת-DoS — בלי allowlist/תקרות
        // מסמך-הצטרפות יכול היה להגיע ל-1MB בכל slug (זבל בלוח-המנהל). עכשיו:
        // 5 שדות מוכרים בלבד (email/name/phone/code/at) + תקרות-גודל, מקביל
        // ל-platformLeads. כל הכותבים בפועל משתמשים בדיוק בשדות האלה ⇒ לא-שובר.
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['email', 'name', 'phone', 'code', 'at'])
          && (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 120))
          && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 100))
          && (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 30))
          && (!('code' in request.resource.data) || (request.resource.data.code is string && request.resource.data.code.size() <= 60))
          && (!('at' in request.resource.data) || (request.resource.data.at is string && request.resource.data.at.size() <= 40));
        allow read, delete: if superAdmin() || orgManager(slug);
      }
    }

    // ייעודי-התרומה שהעובד/ת המחובר/ת רשאי/ת (מסלול-B P3): מ-memberConfigs; ריק/חסר
    // ⇒ בלי הגבלה (מנהל/עובד-לא-מוגבל), עקבי עם allowedDesignationsFor בקליינט.
    function memberDesignations(slug) {
      return get(/databases/$(database)/documents/platformOrgs/$(slug)).data
        .get('memberConfigs', {})
        .get(request.auth.token.email.lower(), {})
        .get('designations', []);
    }
    function memberSeesPurpose(slug, pkey) {
      return orgMember(slug)
        && (memberDesignations(slug).size() == 0    // בלי-הגבלה
            || pkey == '_shared_'                    // תרומה משותפת = גלויה לכל
            || pkey in memberDesignations(slug));
    }
    // אכיפת-תומכים (15.8) — זהה ל-memberSeesPurpose אך על מפתח-התומך (skey=forWho).
    // עובד/ת ללא-הגבלה רואה הכל; תומך משותף ('_shared_') גלוי לכל; אחרת רק ייעוד-מותר.
    function memberSeesSupporter(slug, skey) {
      return orgMember(slug)
        && (memberDesignations(slug).size() == 0
            || skey == '_shared_'
            || skey in memberDesignations(slug));
    }

    // נתוני ארגון-פלטפורמה: כתיבה — חבר או מייל-על (הסנכרון דוחף). קריאה — חבר,
    // **פרט לאוסף-התרומות** (מסלול-B): קריאתו נאכפת פר-ייעוד במאץ' הייעודי למטה.
    match /orgs/{slug}/{col}/{docId} {
      // 🔴 נחיל-אבטחה 16.8 (CRITICAL) — הכתיבה-הכללית חייבת להחריג בדיוק כמו הקריאה.
      // Firestore = OR של כללים: `allow write` רחב על אוסף שיש-לו-מאץ'-ייעודי **גובר**
      // עליו ⇒ עובד-מוגבל היה יכול להפוך pkey/skey ל-'_shared_' ולקרוא/למחוק/לזייף
      // קבלת-§46 ו-PII של ייעוד-אסור (canWriteKeyed הפך לקוד-מת). כל אוסף כאן נאכף
      // בבלוק-ייעודי משלו (donations/supporters/events פר-מפתח · תורי-PII · auditlog),
      // לכן ההחרגה בטוחה — הכתיבה נופלת לבלוק-הייעודי. `_enc` = כספת-ה-DEK (בלוק למטה).
      allow write: if (superAdmin() || orgMember(slug))
        && !(col in ['donations', 'supporters', 'events', 'auditlog', 'incomingPayments', 'smsOutbox', 'mailOutbox', '_enc', 'meta']);
      // אכיפת-ייעוד (נחיל 16.8): donations/supporters/events נאכפים פר-skey/pkey למטה;
      // תורי-ה-PII (incomingPayments/smsOutbox/mailOutbox) נושאים שמות/סכומי-תורמים ⇒
      // קריאה=מנהל בלבד; auditlog=מנהל. כולם מוחרגים מהקריאה-הכללית-לחבר.
      allow read: if (superAdmin() || orgMember(slug))
        && !(col in ['donations', 'supporters', 'events', 'auditlog', 'incomingPayments', 'smsOutbox', 'mailOutbox']);
    }

    // ── פונקציית-עזר לכתיבה-פר-ייעוד: הכותב רשאי את מפתח-החלוקה (skey/pkey) הן של
    // המסמך-הקיים והן של המבוקש. חוסמת את "הפיכת-המפתח-ל-_shared_" ואת מחיקת/דריסת
    // מסמך של ייעוד-אסור (נחיל 16.8 · CRITICAL). מנהל/מייל-על עוקפים. ─────────────
    function canWriteKeyed(slug, existingKey, newKey) {
      return superAdmin() || orgManager(slug)
        || (memberSeesPurpose(slug, existingKey) && memberSeesPurpose(slug, newKey));
    }
    function canWriteKeyedSup(slug, existingKey, newKey) {
      return superAdmin() || orgManager(slug)
        || (memberSeesSupporter(slug, existingKey) && memberSeesSupporter(slug, newKey));
    }

    // מסלול-B — אוסף-התרומות הנפרד: **קריאה וגם כתיבה פר-ייעוד**. הכתיבה נאכפת כדי
    // שחבר-מוגבל לא יוכל להפוך pkey ל-_shared_ ולקרוא הכל, ולא ימחק/יזייף קבלת-§46
    // של ייעוד-אסור. skey/pkey plaintext (מחוץ למעטפה) כדי ש-where-in של הקליינט יעבור.
    // #6 (16.8 · הכרעת-בעלים 14.8 "רק מנהל מנפיק קבלה") — **יצירה=מנהל/מייל-על בלבד**
    // (מקבילה ל-canIssueReceipt בקליינט; עובד לא-מנהל חסום מהנפקת-קבלה גם בכתיבה-
    // ישירה, במצב-מפוצל). עדכון/מחיקה נשארים פר-ייעוד (עריכת-קיים בתחום-המותר).
    match /orgs/{slug}/donations/{id} {
      allow read: if superAdmin() || orgManager(slug) || memberSeesPurpose(slug, resource.data.get('pkey', '_shared_'));
      allow create: if superAdmin() || orgManager(slug);
      // 🛡️ הגנת-קבלות (לולאת-האמון 8, 24.8 — טיוטה, הפרסום=חלון-בעלים+רו"ח):
      // ביקורת-העומק מצאה שחבר-מוגבל יכול היה **לעדכן/למחוק** מסמך-קבלה-§46
      // בתחום-הייעוד שלו (memberSeesPurpose/canWriteKeyed). עכשיו עדכון/מחיקה =
      // מנהל/מייל-על בלבד — סימטרי ל"רק מנהל מנפיק" (create), ושומר את הזרימות
      // הלגיטימיות של המנהל (מספור-מחדש planRidRenumber, מחיקת-כרטיס מדורגת).
      // אופציה מחמירה (הכרעת-רו"ח, טרם הוכרעה): append-only מלא — allow update,
      // delete: if false; — תיקון-קבלה יהיה רק במסמך-זיכוי (שטרם קיים ל-D-/R-).
      allow update: if superAdmin() || orgManager(slug);
      allow delete: if superAdmin() || orgManager(slug);
    }

    // אכיפת-תומכים (15.8) — קריאה **וכתיבה** פר-ייעוד (skey=forWho). תאימות-לאחור
    // קריטית: skey חסר (טרם-מיגרציה) ⇒ '_shared_' ⇒ גלוי/כתיב לכל חבר ⇒ פרסום-ה-Rules
    // אינו שובר ארגון שלא הריץ מיגרציה. רק מסמך עם skey-אמת נאכף פר-ייעוד.
    match /orgs/{slug}/supporters/{id} {
      allow read: if superAdmin() || orgManager(slug) || memberSeesSupporter(slug, resource.data.get('skey', '_shared_'));
      allow create: if superAdmin() || orgManager(slug) || memberSeesSupporter(slug, request.resource.data.get('skey', '_shared_'));
      allow update: if canWriteKeyedSup(slug, resource.data.get('skey', '_shared_'), request.resource.data.get('skey', '_shared_'));
      allow delete: if superAdmin() || orgManager(slug) || memberSeesSupporter(slug, resource.data.get('skey', '_shared_'));
    }

    // אכיפת-לוח (15.8) — אירוע-מעקב מקושר-תומך נושא את מפתח-התומך (skey). קריאה+כתיבה
    // פר-ייעוד כמו התומכים; אירוע כללי/טרם-מיגרציה ⇒ '_shared_' ⇒ גלוי/כתיב לכל חבר.
    match /orgs/{slug}/events/{id} {
      allow read: if superAdmin() || orgManager(slug) || memberSeesSupporter(slug, resource.data.get('skey', '_shared_'));
      allow create: if superAdmin() || orgManager(slug) || memberSeesSupporter(slug, request.resource.data.get('skey', '_shared_'));
      allow update: if canWriteKeyedSup(slug, resource.data.get('skey', '_shared_'), request.resource.data.get('skey', '_shared_'));
      allow delete: if superAdmin() || orgManager(slug) || memberSeesSupporter(slug, resource.data.get('skey', '_shared_'));
    }

    // תורי-PII (נחיל 16.8 · HIGH) — incomingPayments/smsOutbox/mailOutbox נושאים
    // שם/טלפון/סכום/נוסח-קבלה של תורמים ⇒ **קריאה=מנהל/מייל-על בלבד** (עובדת-מוגבלת
    // לא תעקוף את פירוק-ה-skey דרך תורי-ההודעות). כתיבה=חבר (הלקוח מזין לתור).
    match /orgs/{slug}/incomingPayments/{id} {
      allow write: if superAdmin() || orgMember(slug);
      allow read: if superAdmin() || orgManager(slug);
    }
    match /orgs/{slug}/smsOutbox/{id} {
      allow write: if superAdmin() || orgMember(slug);
      allow read: if superAdmin() || orgManager(slug);
    }
    match /orgs/{slug}/mailOutbox/{id} {
      allow write: if superAdmin() || orgMember(slug);
      allow read: if superAdmin() || orgManager(slug);
    }

    // לוג-מנהל מסונכרן (15.8, "מנהל מסונכרן") — auditlog/{uid}: כל חבר כותב **רק**
    // את מסמכו (טבעת-פעולותיו, uid=חשבונו); **קריאה = מנהל/מייל-על בלבד** ⇒ מנהל
    // רואה את פעולות כולן, ועובדת לא לומדת על פעולה של אחרת. הלוג לא רוכב על meta.
    match /orgs/{slug}/auditlog/{uid} {
      allow write: if request.auth != null && request.auth.uid == uid && orgMember(slug);
      allow read: if superAdmin() || orgManager(slug);
    }

    // כספת-מפתחות פר-ארגון (9.8 — "כל מנהל יש את הסודות שלו"): טוקני ימות/
    // נדרים/SMS/SMTP של הלקוח. אוסף-שורש **במכוון** — תחת orgs/ כל חבר-ארגון
    // היה קורא (Firestore = OR של כללים). המנהל כותב; **איש לא קורא מהדפדפן**
    // (גם לא הכותב) — רק ה-functions (Admin SDK, עוקף Rules) משתמשות בסוד.
    match /orgSecrets/{slug} {
      allow write: if superAdmin() || orgManager(slug);
      allow read: if false;
    }
    // מדדי-"מוגדר ✓" — בוליאנים בלבד, בלי הסוד: קריאים לחברי-הארגון.
    match /orgSecretsMeta/{slug} {
      allow read: if superAdmin() || orgMember(slug);
      allow write: if superAdmin() || orgManager(slug);
    }

    // מנוי-יומן חי (gcal feed, 9.8): הלקוח מפרסם ICS + token סודי; חברי-הארגון
    // כותבים/מרעננים, והעולם מקבל **רק** דרך פונקציית icsFeed (Admin SDK) עם
    // ה-token. אוסף-שורש (כמו הכספת); הארגון-השורש (default) — דרך allowedRoot.
    match /icsFeeds/{slug} {
      // 21.8: הלקוח-החי מפרסם עם slug 'maor-hachesed' (public/c/maor-hachesed) —
      // הבריחה של 'default' לבדה הייתה מתה עבורו (מוסווה היום כי allowedRoot≡מייל-העל;
      // נשברת ברגע שנוסף מייל-משרד שני). שני ה-slugs של השורש עוברים דרך allowedRoot.
      allow read, write: if superAdmin() || orgMember(slug)
        || ((slug == 'default' || slug == 'maor-hachesed') && allowedRoot());
    }

    // 💬 צ׳אט-צוות תוך-ארגוני (17.8) — ערוץ-קבוצה אחד לכל הארגון: כל אנשי-הצוות
    // (orgMember; שורש-default דרך allowedRoot) קוראים/כותבים חי. הודעות = create
    // בלבד (בלתי-משתנות); טקסט תחום-גודל + hasOnly (DoS). מגודר `shell.teamchat`
    // בקליינט (Rules לא יודעות דגלים). teamChats מוחרג מ-catch-all השורש למטה.
    match /teamChats/{slug}/messages/{id} {
      // 21.8: כמו ב-icsFeeds — גם 'maor-hachesed' (ה-slug של הלקוח-החי) הוא שורש
      // לעניין allowedRoot, אחרת מייל-משרד שני (לא מייל-על) היה ננעל בחוץ.
      allow read: if superAdmin() || orgMember(slug) || ((slug == 'default' || slug == 'maor-hachesed') && allowedRoot());
      allow create: if (superAdmin() || orgMember(slug) || ((slug == 'default' || slug == 'maor-hachesed') && allowedRoot()))
        && request.resource.data.keys().hasOnly(['sender', 'name', 'text', 'at'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
        && (!('sender' in request.resource.data) || (request.resource.data.sender is string && request.resource.data.sender.size() <= 120))
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 60))
        && (!('at' in request.resource.data) || (request.resource.data.at is string && request.resource.data.at.size() <= 40));
    }

    // הצפנת-ענן (opt-in) — מסמך ה-envelope (ה-DEK העטוף):
    //   • שורש (הלקוח הקיים): `_enc/envelope` מכוסה ע"י catch-all השורש למטה.
    //   • ארגון-פלטפורמה: `orgs/{slug}/_enc/{d}` — בלוק ייעודי כאן.
    // ה-envelope הוא ciphertext בלבד (חסר-ערך בלי הסיסמה) ⇒ **קריאה=חבר** (הלקוח
    // מושך אותו כדי לפתוח את ה-DEK). 🔴 נחיל-אבטחה 16.8: **כתיבה=מנהל/מייל-על בלבד**
    // — אחרת עובד-מוגבל היה מוחק את ה-envelope (DoS על ההצפנה: הארגון לא מפענח יותר).
    // רק enableCloudEncryption/cloudUnlock (פעולת-בעלים) כותבים אותו.
    match /orgs/{slug}/_enc/{d} {
      allow read: if superAdmin() || orgMember(slug);
      allow write: if superAdmin() || orgManager(slug);
    }

    // #7 (16.8) — מסמך meta/org: מוני-רצף-הקבלות (seq/receiptSeq/donationSeq/
    // shopReceiptSeq) **מונוטוניים בשרת** — כתיבה שמורידה מונה נדחית (מונעת גלגול-
    // אחורה = שכפול-rid). הלקוח כבר מבטיח זאת (pushMetaCounterSafe מרים-למקסימום
    // בעסקה) ⇒ כתיבה-לגיטימית לעולם לא נדחית; רק כתיבה-ישירה-זדונית שמנמיכה נחסמת.
    // הקפצה-מעלה מותרת (רצף עם פער = פגם-חשבונאי קל, לא שכפול). ארגון-מוצפן: המונים
    // בתוך ה-ciphertext ⇒ אין שדה-מונה לקרוא ⇒ הכלל no-op (בטוח). meta מוחרג
    // מהכתיבה-הכללית (col 'meta') ⇒ הבלוק הזה הוא השער היחיד.
    function metaCounterOk(f) {
      return !(f in request.resource.data) || resource == null || !(f in resource.data)
        || !(resource.data[f] is number) || !(request.resource.data[f] is number)
        || request.resource.data[f] >= resource.data[f];
    }
    match /orgs/{slug}/meta/{id} {
      allow read: if superAdmin() || orgMember(slug);
      allow write: if (superAdmin() || orgMember(slug))
        && metaCounterOk('seq') && metaCounterOk('receiptSeq')
        && metaCounterOk('donationSeq') && metaCounterOk('shopReceiptSeq');
    }

    // אוספי השורש (הלקוח הקיים, cloudRoot) — allowlist כהיום + מיילי-על.
    // צמצום-אבטחה (ציד-באגים 3.8.2026): קודם היה כלל רקורסיבי /{document=**} שתפס
    // **גם** את platformOrgs/orgs (Firestore = OR של הכללים) ⇒ מייל ב-allowedRoot
    // קיבל כתיבה חוצת-ארגונים. עכשיו {rootCol} תופס את שם-האוסף-הראשון וה-allowlist
    // מתיר כל אוסף-שורש **פרט** לארבעת אוספי-הפלטפורמה (שלהם כללים ייעודיים
    // superAdmin/member/manager). הלקוח החי לא נשבר (23 אוספי-השורש — families…
    // deliveries + meta + _enc — כולם מחוץ לרשימת-האיסור; אומת אדוורסרית). מייל
    // ב-allowedRoot כבר לא נוגע בנתוני ארגון אחר. מייל-על שומר גישה מלאה דרך הכללים
    // הייעודיים. אזהרה עתידית: אין לקרוא לאוסף-שורש חדש בשם platform*/orgs.
    // ‏9.8: גם אוספי-הכספת והפיד מוחרגים — אחרת מייל ב-allowedRoot (למשל מייל-
    // המשרד העתידי) היה קורא דרך ה-catch-all את הסודות/הפידים של **כל** הארגונים
    // (Firestore = OR של כללים; read:false בכלל הייעודי לא גובר על התרה כאן).
    match /{rootCol}/{document=**} {
      allow read, write: if (allowedRoot() || superAdmin())
        && !(rootCol in ['platformOrgs', 'platformRequests', 'platformLeads', 'orgs', 'orgSecrets', 'orgSecretsMeta', 'icsFeeds', 'supportChats', 'teamChats']);
    }
  }
}
