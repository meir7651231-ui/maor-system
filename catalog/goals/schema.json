{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalog/goals/schema.json",
  "title": "מילון המטרות — עולם אחד",
  "description": "Goals dictionary, one file per world (catalog/goals/<world>.json). Each goal = a word and what it DOES, broken into world-free (verb, material) needs. See catalog/goals/README.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "world",
    "goals"
  ],
  "properties": {
    "world": {
      "type": "string",
      "minLength": 2,
      "pattern": "^[^A-Za-z]+$"
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "word",
          "emoji",
          "does",
          "needs"
        ],
        "properties": {
          "word": {
            "type": "string",
            "minLength": 2,
            "pattern": "^[א-ת][א-ת׳״'-]*[א-ת]$"
          },
          "emoji": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12
          },
          "does": {
            "type": "string",
            "minLength": 10,
            "maxLength": 240,
            "pattern": "^[^A-Za-z]+$"
          },
          "needs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "behavior",
                "verb",
                "material"
              ],
              "properties": {
                "behavior": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 80,
                  "pattern": "^[^A-Za-z]+$"
                },
                "verb": {
                  "type": "string",
                  "pattern": "^(divide|merge|next|round|offset|escalate|rotate|fuzzy|sort|filter|dedupe|reverse|map|transcript|group|tally|count|sum|average|extreme|lookup|tier|clamp|normalize|settle|convert|format|fingerprint|bucket|personalize|validate|compare|gap|ratio|combine|split|join|provide|require-source|freeze|assign-role|route|tolerate|pace|relay|decay|countdown|accumulate|oscillate|random|gravity|move-along-path|orbit|shortest-path|spread|sample|echo|follow|bounce|sun-position|sun-heading|NEW:[a-z][a-z0-9-]*)$",
                  "description": "מזהה מ-catalog/verbs.json (60 פעלים, כולל 15 פעלי-הזמן-והתנועה שנכרו — catalog/core), או NEW:<id> לפועל שעוד אין בשום מקום."
                },
                "material": {
                  "type": "string",
                  "pattern": "^(span|amount|number|times|date|sequence|list|waiting|text|bool|geo|image|sound|file|choice|ui|unknown|record:[a-z][A-Za-z0-9]*)$"
                },
                "detail": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "note": {
                  "type": "string",
                  "minLength": 10,
                  "maxLength": 400,
                  "description": "למה הפועל/החומר מופו כך (עריכת-מילון — הטקסט של ההתנהגות לא משתנה). MACHINE-V3."
                }
              }
            }
          }
        }
      }
    }
  }
}
