   "material": "geo",
   "chain": [
    "core-c:catalog/core/nearest-point.mjs#nearestPoint",
    "inner-orbit:src/components/supporters/SupportersGalaxy.tsx#SupportersGalaxy.useEffect.frame.d",
    "core-c:catalog/core/by-distance.mjs#byDistance"
   ]
  }
 ]
}
