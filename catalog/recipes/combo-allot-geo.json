{
 "id": "combo-allot-geo",
 "word": "allot · geo",
 "title": "שילוב «משבץ עד התקרה» (משבץ-עד-התקרה, allot · capacitated): 3 חלקים — בוחר את הנקודה הקרובה ביותר למוצא ⇒ … ⇒ ממיין נקודות לפי המרחק מהמוצא",
 "combo": {
  "verb": "allot",
  "material": "geo",
  "form": "graph",
  "steps": [
   "core-c:catalog/core/nearest-point.mjs#nearestPoint",
   "inner-orbit:src/components/supporters/SupportersGalaxy.tsx#SupportersGalaxy.useEffect.frame.d",
   "core-c:catalog/core/by-distance.mjs#byDistance"
  ],
  "roles": [
   "extreme",
   "convert",
   "sort"
  ],
  "holds": "53/53",
  "laws": [
   "allot.once",
   "allot.cap",
   "allot.full",
   "allot.ample",
   "allot.det"
  ],
  "hint": "רכב שמחזיק עד K סלים = K תאים בכל מתנדב, ותא-המתנה רחוק מאוד לכל פריט; כל משפחה (מהקרובה-למתנדב-שלה ראשונה — המרחק לכוכב-הקרוב של הגלקסיה, ממוין בליבת «ממיין») לוקחת את התא הפנוי הקרוב (ממיין ⇒ הראשון), והתא יוצא מהרשימה",
  "takes": [
   "geo",
   "geo",
   "number"
  ],
  "gives": "list",
  "graph": {
   "inputs": [
    "bins",
    "items",
    "cap"
   ],
   "consts": {
    "far": "{x:1e9, y:1e9, b:-1} — תא-המתנה: רחוק מכל מקום על המפה, ולכן נלקח רק כשאין תא פנוי אצל אף מתנדב",
    "slots": "K עותקים של כל מתנדב: לולאה על K הפריטים הראשונים (רק המספר שלהם משמש) — כשיש פחות פריטים מ-K, יש מקום לכולם ממילא",
    "origin0": "{x:0, y:0} — מיון לפי {x: מרחק} = מהקרוב לרחוק",
    "loops": "🔁 הלולאות חיווט בלבד (graph.mjs: loop)"
   },
   "nodes": [
    {
     "id": "slots",
     "loop": {
      "over": "$bins",
      "init": 0,
      "item": "v",
      "index": "bi",
      "state": "z",
      "nodes": [
       {
        "id": "rep",
        "loop": {
         "over": {
          "$slice": [
           "$items",
           0,
           "$cap"
          ]
         },
         "init": 0,
         "item": "w0",
         "state": "y",
         "nodes": [],
         "next": "$y",
         "emit": {
          "x": "$v.x",
          "y": "$v.y",
          "b": "$bi"
         }
        },
        "says": "K תאים במקום של המתנדב"
       }
      ],
      "next": "$z",
      "emit": "@rep.emits"
     },
     "says": "כל התאים של כל המתנדבים"
    },
    {
     "id": "wait",
     "loop": {
      "over": "$items",
      "init": 0,
      "item": "w1",
      "state": "y1",
      "nodes": [],
      "next": "$y1",
      "emit": {
       "x": 1000000000,
       "y": 1000000000,
       "b": -1
      }
     },
     "says": "תא-המתנה לכל פריט"
    },
    {
     "id": "key",
     "loop": {
      "over": "$items",
      "init": 0,
      "item": "p",
      "state": "y2",
      "nodes": [
       {
        "id": "nb",
        "part": "core-c:catalog/core/nearest-point.mjs#nearestPoint",
        "role": "extreme",
        "args": [
         "$bins",
         "$p"
        ],
        "says": "המתנדב הקרוב"
       },
       {
        "id": "dk",
        "part": "inner-orbit:src/components/supporters/SupportersGalaxy.tsx#SupportersGalaxy.useEffect.frame.d",
        "role": "convert",
        "args": [
         "$p.x",
         "$p.y",
         "@nb"
        ],
        "says": "כמה רחוק הוא"
       }
      ],
      "next": "$y2",
      "emit": {
       "x": "@dk",
       "y": 0,
       "item": "$p"
      }
     },
     "says": "לכל משפחה: המרחק למתנדב הקרוב"
    },
    {
     "id": "ord",
     "part": "core-c:catalog/core/by-distance.mjs#byDistance",
     "role": "sort",
     "args": [
      "@key.emits",
      {
       "x": 0,
       "y": 0
      }
     ],
     "says": "הקרובות-למתנדב ראשונות"
    },
    {
     "id": "asg",
     "loop": {
      "over": "@ord",
      "init": {
       "$cat": [
        {
         "$cat": "@slots.emits"
        },
        "@wait.emits"
       ]
      },
      "item": "w",
      "state": "f",
      "nodes": [
       {
        "id": "s",
        "part": "core-c:catalog/core/by-distance.mjs#byDistance",
        "role": "sort",
        "args": [
         "$f",
         "$w.item"
        ],
        "says": "התאים הפנויים — מהקרוב לרחוק"
       }
      ],
      "next": {
       "$slice": [
        "@s",
        1
       ]
      },
      "emit": {
       "item": "$w.item",
       "b": "@s.0.b"
      }
     },
     "says": "כל משפחה לוקחת את התא הפנוי הקרוב"
    }
   ],
   "out": "@asg.emits"
  }
 },
 "needs": [
  {
   "need": "combo",
