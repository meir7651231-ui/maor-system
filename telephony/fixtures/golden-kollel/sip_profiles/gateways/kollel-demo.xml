<?xml version="1.0" encoding="utf-8"?>
<!-- שער-ה-GSM של הלקוח (ציוד בבעלותו, עם ה-SIM שלו). זה לא ספק — זה הלקוח. -->
<!-- כתובת-ה-IP והסיסמה מוזרקות בהתקנה לפי הרשת של הלקוח. -->
<include>
  <gateway name="kollel-demo-gw1">
    <!-- מזכירות · +97226000000 · ערוץ 1 -->
    <param name="username" value="kollel-demo-gw1"/>
    <param name="password" value="$${gsm_gateway_password}"/>
    <param name="proxy" value="$${gsm_gateway_ip}"/>
    <param name="register" value="false"/>
    <param name="caller-id-in-from" value="true"/>
    <!-- שיחה נכנסת מה-SIM הזה נופלת להקשר-השער הייחודי (זיהוי-קו אמין) -->
    <param name="context" value="tenant_kollel-demo_gw1"/>
  </gateway>
  <gateway name="kollel-demo-gw2">
    <!-- ראש הכולל · +972506000000 · ערוץ 2 -->
    <param name="username" value="kollel-demo-gw2"/>
    <param name="password" value="$${gsm_gateway_password}"/>
    <param name="proxy" value="$${gsm_gateway_ip}"/>
    <param name="register" value="false"/>
    <param name="caller-id-in-from" value="true"/>
    <!-- שיחה נכנסת מה-SIM הזה נופלת להקשר-השער הייחודי (זיהוי-קו אמין) -->
    <param name="context" value="tenant_kollel-demo_gw2"/>
  </gateway>
</include>
