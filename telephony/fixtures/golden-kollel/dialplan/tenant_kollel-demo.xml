<?xml version="1.0" encoding="utf-8"?>
<!-- מחולל אוטומטית מקונפיג-הלקוח. אין לערוך ידנית — ערוך את הנתונים והרץ מחדש. -->
<!-- כולל אברכים · pure-downstream · 2 מספרים נושאי-קול · 2 ערוצי-יציאה -->
<include>
  <context name="tenant_kollel-demo">

    <!-- setup: התנהגות עצמאית (לא תלוי vars.xml של השרת) -->
    <extension name="setup_defaults" continue="true">
      <condition>
        <action application="set" data="hangup_after_bridge=true"/>
        <action application="set" data="continue_on_fail=true"/>
        <action application="set" data="max_forwards=20"/>
      </condition>
    </extension>
    <extension name="cid_normalize" continue="true">
      <condition break="never"><action application="set" data="cid_e164=${caller_id_number}"/></condition>
      <condition field="caller_id_number" expression="^00([1-9]\d+)$" break="never"><action application="set" data="cid_e164=+$1"/></condition>
      <condition field="caller_id_number" expression="^0([1-9]\d+)$" break="never"><action application="set" data="cid_e164=+972$1"/></condition>
      <condition field="caller_id_number" expression="^(972\d+)$" break="never"><action application="set" data="cid_e164=+$1"/></condition>
      <condition field="caller_id_number" expression="^([1-9]\d{6,8})$" break="never"><action application="set" data="cid_e164=+972$1"/></condition>
      <condition field="caller_id_number" expression="^([1-9]\d{9,14})$" break="never"><action application="set" data="cid_e164=+$1"/></condition>
      <condition field="${cid_e164}" expression="^\+9720([1-9]\d+)$" break="never"><action application="set" data="cid_e164=+972$1"/></condition>
    </extension>

    <!-- שער-הזמן: ברירת-מחדל סגור; global_open לפי שעות, force_closed לפי חג/dnd/חירום -->
    <extension name="gate_default" continue="true">
      <condition>
        <action application="set" data="global_open=false"/>
        <action application="set" data="force_closed=false"/>
      </condition>
    </extension>
    <extension name="office_window" continue="true">
      <condition wday="1-5" time-of-day="10:00-15:00">
        <action application="set" data="global_open=true"/>
      </condition>
    </extension>

    <!-- לוח-עברי: 15 ימי-חג → סגור (מחושב מ-2026-09-01, חלון 400 יום) -->
    <extension name="heb_20260912" continue="true">
      <condition date-time="2026-09-12 00:00:00~2026-09-12 23:59:59">
        <action application="set" data="force_closed=true"/>
        <action application="set" data="closed_kind=holiday"/>
        <action application="set" data="closed_reason=ראש השנה"/>
      </condition>
    </extension>
    <extension name="heb_20260913" continue="true">
      <condition date-time="2026-09-13 00:00:00~2026-09-13 23:59:59">
        <action application="set" data="force_closed=true"/>
        <action application="set" data="closed_kind=holiday"/>
        <action application="set" data="closed_reason=ראש השנה"/>
      </condition>
    </extension>
    <extension name="heb_20260914" continue="true">
      <condition date-time="2026-09-14 00:00:00~2026-09-14 23:59:59">
        <action application="set" data="force_closed=true"/>
        <action application="set" data="closed_kind=holiday"/>
        <action application="set" data="closed_reason=צום גדליה"/>
      </condition>
    </extension>
    <extension name="heb_20260921" continue="true">
      <condition date-time="2026-09-21 00:00:00~2026-09-21 23:59:59">
        <action application="set" data="force_closed=true"/>
        <action application="set" data="closed_kind=holiday"/>
        <action application="set" data="closed_reason=יום כיפור"/>
      </condition>
    </extension>
    <extension name="heb_20260926" continue="true">
      <condition date-time="2026-09-26 00:00:00~2026-09-26 23:59:59">
        <action application="set" data="force_closed=true"/>
        <action application="set" data="closed_kind=holiday"/>
        <action application="set" data="closed_reason=סוכות"/>
      </condition>
    </extension>
    <extension name="heb_20261003" continue="true">
      <condition date-time="2026-10-03 00:00:00~2026-10-03 23:59:59">
        <action application="set" data="force_closed=true"/>
        <action application="set" data="closed_kind=holiday"/>
        <action application="set" data="closed_reason=שמיני עצרת · שמחת תורה"/>
      </condition>
    </extension>
    <extension name="heb_20261220" continue="true">
      <condition date-time="2026-12-20 00:00:00~2026-12-20 23:59:59">
        <action application="set" data="force_closed=true"/>
        <action application="set" data="closed_kind=holiday"/>
        <action application="set" data="closed_reason=עשרה בטבת"/>
      </condition>
    </extension>
    <extension name="heb_20270322" continue="true">
      <condition date-time="2027-03-22 00:00:00~2027-03-22 23:59:59">
        <action application="set" data="force_closed=true"/>
        <action application="set" data="closed_kind=holiday"/>
        <action application="set" data="closed_reason=תענית אסתר"/>
      </condition>
    </extension>
    <extension name="heb_20270422" continue="true">
      <condition date-time="2027-04-22 00:00:00~2027-04-22 23:59:59">
        <action application="set" data="force_closed=true"/>
        <action application="set" data="closed_kind=holiday"/>
        <action application="set" data="closed_reason=פסח"/>
      </condition>
    </extension>
    <extension name="heb_20270428" continue="true">
      <condition date-time="2027-04-28 00:00:00~2027-04-28 23:59:59">
        <action application="set" data="force_closed=true"/>
        <action application="set" data="closed_kind=holiday"/>
        <action application="set" data="closed_reason=שביעי של פסח"/>
      </condition>
    </extension>
    <extension name="heb_20270611" continue="true">
      <condition date-time="2027-06-11 00:00:00~2027-06-11 23:59:59">
        <action application="set" data="force_closed=true"/>
        <action application="set" data="closed_kind=holiday"/>
        <action application="set" data="closed_reason=שבועות"/>
      </condition>
    </extension>
    <extension name="heb_20270812" continue="true">
      <condition date-time="2027-08-12 00:00:00~2027-08-12 23:59:59">
        <action application="set" data="force_closed=true"/>
        <action application="set" data="closed_kind=holiday"/>
        <action application="set" data="closed_reason=תשעה באב"/>
      </condition>
    </extension>
    <extension name="heb_20271002" continue="true">
      <condition date-time="2027-10-02 00:00:00~2027-10-02 23:59:59">
        <action application="set" data="force_closed=true"/>
        <action application="set" data="closed_kind=holiday"/>
        <action application="set" data="closed_reason=ראש השנה"/>
      </condition>
    </extension>
    <extension name="heb_20271003" continue="true">
      <condition date-time="2027-10-03 00:00:00~2027-10-03 23:59:59">
        <action application="set" data="force_closed=true"/>
        <action application="set" data="closed_kind=holiday"/>
        <action application="set" data="closed_reason=ראש השנה"/>
      </condition>
    </extension>
    <extension name="heb_20271004" continue="true">
      <condition date-time="2027-10-04 00:00:00~2027-10-04 23:59:59">
        <action application="set" data="force_closed=true"/>
        <action application="set" data="closed_kind=holiday"/>
        <action application="set" data="closed_reason=צום גדליה"/>
      </condition>
    </extension>

    <!-- כניסה: קווים-מופנים מזוהים לפי DID (תלוי בכך שהספק משמרו) -->

    <!-- ניתוב: force_closed→do_closed · global_open→do_open · אחרת→do_closed -->
    <extension name="incoming_closed">
      <condition field="destination_number" expression="^incoming$"/>
      <condition field="${force_closed}" expression="^true$">
        <action application="transfer" data="do_closed XML tenant_kollel-demo"/>
      </condition>
    </extension>
    <extension name="incoming">
      <condition field="destination_number" expression="^incoming$"/>
      <condition field="${global_open}" expression="^true$">
        <action application="transfer" data="do_open XML tenant_kollel-demo"/>
        <anti-action application="transfer" data="do_closed XML tenant_kollel-demo"/>
      </condition>
    </extension>
    <extension name="do_open">
      <condition field="destination_number" expression="^do_open$">
        <action application="bridge" data="{leg_timeout=25}user/101@kollel-demo"/>
        <action application="transfer" data="afterhours XML tenant_kollel-demo"/>
      </condition>
    </extension>
    <extension name="do_closed">
      <condition field="destination_number" expression="^do_closed$">
        <action application="transfer" data="afterhours XML tenant_kollel-demo"/>
      </condition>
    </extension>
    <extension name="afterhours">
      <condition field="destination_number" expression="^afterhours$">
        <action application="bridge" data="{leg_timeout=30}user/201@kollel-demo"/>
        <action application="answer"/>
        <action application="sleep" data="500"/>
        <action application="voicemail" data="default kollel-demo 100"/>
      </condition>
    </extension>

    <!-- יציאה: קידומת <ערוץ>#<מספר> בוחרת דרך איזה SIM לצאת (רק שלוחה-רשומה) -->
    <extension name="out_pick_n1">
      <condition field="${sip_authorized}" expression="^true$"/>
      <condition field="destination_number" expression="^1#(\+?\d+)$">
        <action application="set" data="effective_caller_id_number=+97226000000"/>
        <action application="set" data="effective_caller_id_name=מזכירות"/>
        <action application="bridge" data="sofia/gateway/kollel-demo-gw1/$1"/>
      </condition>
    </extension>
    <extension name="out_pick_n2">
      <condition field="${sip_authorized}" expression="^true$"/>
      <condition field="destination_number" expression="^2#(\+?\d+)$">
        <action application="set" data="effective_caller_id_number=+972506000000"/>
        <action application="set" data="effective_caller_id_name=ראש הכולל"/>
        <action application="bridge" data="sofia/gateway/kollel-demo-gw2/$1"/>
      </condition>
    </extension>
    <!-- יציאת-ברירת-מחדל מקומית (חיוג רגיל בלי קידומת) → מזכירות -->
    <extension name="out_default">
      <condition field="${sip_authorized}" expression="^true$"/>
      <condition field="destination_number" expression="^(0\d{7,9}|\+?972\d{7,9})$">
        <action application="set" data="effective_caller_id_number=+97226000000"/>
        <action application="bridge" data="sofia/gateway/kollel-demo-gw1/$1"/>
      </condition>
    </extension>

    <!-- אחזור-תא-קולי -->
    <extension name="vm_retrieve">
      <condition field="destination_number" expression="^\*98$">
        <action application="answer"/>
        <action application="voicemail" data="check default kollel-demo 100"/>
      </condition>
    </extension>
  </context>

  <context name="tenant_kollel-demo_gw1">
    <!-- מזכירות · +97226000000 · ערוץ 1 -->
    <extension name="gw1_entry">
      <condition field="destination_number" expression="^.*$">
        <action application="set" data="inbound_call=true"/>
        <action application="set" data="inbound_line=מזכירות"/>
        <action application="set" data="inbound_number=+97226000000"/>
        <action application="transfer" data="incoming XML tenant_kollel-demo"/>
      </condition>
    </extension>
  </context>

  <context name="tenant_kollel-demo_gw2">
    <!-- ראש הכולל · +972506000000 · ערוץ 2 -->
    <extension name="gw2_entry">
      <condition field="destination_number" expression="^.*$">
        <action application="set" data="inbound_call=true"/>
        <action application="set" data="inbound_line=ראש הכולל"/>
        <action application="set" data="inbound_number=+972506000000"/>
        <action application="transfer" data="incoming XML tenant_kollel-demo"/>
      </condition>
    </extension>
  </context>
</include>
