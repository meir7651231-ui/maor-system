<?xml version="1.0" encoding="utf-8"?>
<!-- מחולל אוטומטית — משתמשי כולל אברכים. סיסמאות (סוד פר-שלוחה) מוזרקות בהתקנה. -->
<include>
  <domain name="kollel-demo">
    <users>
      <user id="101">
        <params>
          <param name="password" value="$${PROVISION_PW__kollel-demo__101}"/>
          <param name="vm-password" value="$${VM_PW__kollel-demo__101}"/>
        </params>
        <variables>
          <variable name="user_context" value="tenant_kollel-demo"/>
          <variable name="effective_caller_id_name" value="משרד כולל אברכים"/>
          <variable name="toll_allow" value="domestic"/>
        </variables>
      </user>
      <user id="201">
        <params>
          <param name="password" value="$${PROVISION_PW__kollel-demo__201}"/>
          <param name="vm-password" value="$${VM_PW__kollel-demo__201}"/>
          <param name="vm-mailto" value="rosh@kollel.example"/>
          <param name="vm-attach-file" value="true"/>
        </params>
        <variables>
          <variable name="user_context" value="tenant_kollel-demo"/>
          <variable name="effective_caller_id_name" value="מנהל כולל אברכים"/>
          <variable name="toll_allow" value="domestic"/>
        </variables>
      </user>
      <user id="100">
        <params>
          <param name="password" value="$${PROVISION_PW__kollel-demo__100}"/>
          <param name="vm-password" value="$${VM_PW__kollel-demo__100}"/>
          <param name="vm-mailto" value="rosh@kollel.example"/>
          <param name="vm-attach-file" value="true"/>
        </params>
        <variables>
          <variable name="user_context" value="tenant_kollel-demo"/>
          <variable name="effective_caller_id_name" value="תא-קולי כולל אברכים"/>
          <variable name="toll_allow" value="domestic"/>
        </variables>
      </user>
    </users>
  </domain>
</include>
