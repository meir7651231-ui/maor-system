<?xml version="1.0" encoding="utf-8"?>
<!-- שער-ה-GSM של הלקוח (ציוד בבעלותו, עם ה-SIM שלו). זה לא ספק — זה הלקוח. -->
<!-- כתובת-ה-IP והסיסמה מוזרקות בהתקנה לפי הרשת של הלקוח. -->
<include>
  <gateway name="full-demo-gw1">
    <!-- קו ראשי · +97225000000 · ערוץ 1 -->
    <param name="username" value="full-demo-gw1"/>
    <param name="password" value="$${GSM_PW__full-demo}"/>
    <param name="proxy" value="$${GSM_IP__full-demo}"/>
    <param name="register" value="false"/>
    <param name="caller-id-in-from" value="true"/>
    <!-- שיחה נכנסת מה-SIM הזה נופלת להקשר-השער הייחודי (זיהוי-קו אמין) -->
    <param name="context" value="tenant_full-demo_gw1"/>
  </gateway>
  <gateway name="full-demo-gw2">
    <!-- קו תרומות · +97235000000 · ערוץ 2 -->
    <param name="username" value="full-demo-gw2"/>
    <param name="password" value="$${GSM_PW__full-demo}"/>
    <param name="proxy" value="$${GSM_IP__full-demo}"/>
    <param name="register" value="false"/>
    <param name="caller-id-in-from" value="true"/>
    <!-- שיחה נכנסת מה-SIM הזה נופלת להקשר-השער הייחודי (זיהוי-קו אמין) -->
    <param name="context" value="tenant_full-demo_gw2"/>
  </gateway>
</include>
